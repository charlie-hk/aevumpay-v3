# AevumPay contracts - copy to .env and fill in. Never commit .env.
# Testnet only. Use separate wallets; each needs a little QDAY for gas.

QDAY_RPC_URL="https://rpc-test.qday.info"
QDAY_CHAIN_ID="44005"

# Owner / merchant / fee collector
DEPLOYER_PRIVATE_KEY=""
# Payer who grants the mandate (needs at least 5 tUSD8)
PAYER_PRIVATE_KEY=""
# AI agent that pays invoices within the mandate
AGENT_PRIVATE_KEY=""
# Customer wallet used by the basic payment demo
CUSTOMER_PRIVATE_KEY=""

# Gateway used by `npm run demo` (printed by `npm run deploy`)
V3_DEMO_GATEWAY=""

# Explorer verification (optional)
QDAY_EXPLORER_URL=""
QDAY_EXPLORER_API_KEY=""
