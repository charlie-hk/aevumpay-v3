# AevumPay app - copy to .env and fill in. Never commit .env.
# Testnet only: use dedicated low-balance wallets, never mainnet keys.

# --- Required ---
# Fresh, isolated PostgreSQL database
DATABASE_URL="postgresql://user:password@localhost:5432/aevumpay"
# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# --- Optional: public origin used for same-origin checks on POST requests ---
# Set to your deployed origin (e.g. https://your-app.vercel.app). Defaults to the request origin.
NEXTAUTH_URL=""

# --- Optional: chain and gateway selection ---
NEXT_PUBLIC_QDAY_RPC_URL="https://rpc-test.qday.info"
# "2" (default) uses the verified V2 gateway. "3" uses NEXT_PUBLIC_GATEWAY_ADDRESS
# and REQUIRES a fresh database (V2 and V3 data must never be mixed).
NEXT_PUBLIC_AEVUMPAY_CONTRACT_VERSION="2"
NEXT_PUBLIC_GATEWAY_ADDRESS=""

# --- Optional: server-side merchant signer (testnet only, server-side only) ---
# Lets the registered merchant wallet create invoices and refund from the dashboard.
# Leave empty for a read-only dashboard.
DEPLOYER_PRIVATE_KEY=""

# --- Development only ---
ALLOW_DEMO_SEED=""
SEED_MERCHANT_PASSWORD=""
DEMO_SETTLEMENT=""
